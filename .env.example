# ============================================
# BIAS SYSTEM · 环境变量模板
# ============================================
# 同一个项目同时部署到 Vercel 与 EdgeOne Makers
# 在任一平台的 Dashboard 环境变量处填入以下变量
# 注意：真实 Key 不要提交到 Git

# ----- Vercel / EdgeOne 都要复制 -----

# MiniMax API · 文本分类（古代 / 现代 / 西方）
AI_API_KEY=sk-cp-你的-key-在这里
AI_BASE_URL=https://api.minimaxi.com/v1
AI_MODEL=MiniMax-M3

# MiniMax image-01 · 用于 /api/fusion/ancient 的图像生成
# 不填则 fusion 走 sample 库兜底图（功能仍正常，只是不生成融合图）
IMAGE_API_KEY=
# IMAGE_API_BASE_URL=https://api.minimaxi.com/v1
# IMAGE_MODEL=image-01

# ----- 仅 EdgeOne Makers 必填 -----
# Makers 不读 .env · 把上面变量填到 Project → Settings → Environment Variables
# 同一份 .env.example 也可作为文档参考

# ----- 本地开发 -----
# 本地直接 node server.js 时会读 .env（providers/ancient-fusion-provider.js 内的 loadDotEnv）
# Vercel / EdgeOne 都**不**读 .env · 必须在控制台填环境变量

