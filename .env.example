# ============================================
# BIAS SYSTEM · Vercel 环境变量
# ============================================
# 在 Vercel Dashboard → Project → Settings → Environment Variables 添加
# 注意：值在 Vercel 上是加密存储的，不要把 .env 本地文件提交到 Git
# 注意：部署后**要**改 WESTERN_AI_MODE = real 才会用真 AI（而不是 mock）

# MiniMax API（必填）
AI_API_KEY=sk-cp-你的-key-在这里
AI_BASE_URL=https://api.minimaxi.com/v1
AI_MODEL=MiniMax-M3

# 本地可选：Vercel 不读 .env，把以上值填到 Vercel Environment Variables 即可
# 本地：start-server-with-ai.js 读 .env · 直接 node server.js 也能读

# ============================================
# 古代归类融合像 · /api/fusion/ancient
# 必填：MiniMax image-01 (支持多图参考 + 图像编辑) 的 API Key
# 可选：自定义 base_url / model 名称（不填则用 MiniMax 默认值）
# ============================================
IMAGE_API_KEY=
# IMAGE_API_BASE_URL=https://api.minimaxi.com/v1
# IMAGE_MODEL=image-01

